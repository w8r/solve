# Server
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://admin:devpassword@localhost:27017/graph-collab-dev?authSource=admin

# JWT
JWT_SECRET=dev-jwt-secret-key
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=dev-refresh-secret-key
REFRESH_TOKEN_EXPIRES_IN=7d

# Google OAuth (replace with your dev credentials)
GOOGLE_CLIENT_ID=your-dev-google-client-id
GOOGLE_CLIENT_SECRET=your-dev-google-client-secret

# Redis
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=debug

# Auto-save settings
AUTO_SAVE_INTERVAL_MINUTES=5
AUTO_SAVE_OPERATION_THRESHOLD=50
REVISION_RETENTION_DAYS=90
