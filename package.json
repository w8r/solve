{
  "name": "solve",
  "version": "0.0.1",
  "description": "Solve app - distributed problem-solving with graph visualization. Import aliasing convention: Use descriptive aliases for non-descriptive library names (e.g., import { z as Schema } from 'zod').",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w @solve/api",
    "build": "npm run build --workspaces",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w8r/solve.git"
  },
  "author": "Alexander Milevski <alex@milevski.co>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/w8r/solve/issues"
  },
  "homepage": "https://github.com/w8r/solve#readme",
  "dependencies": {},
  "devDependencies": {}
}
